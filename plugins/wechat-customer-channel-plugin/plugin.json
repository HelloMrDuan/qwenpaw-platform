{
  "id": "wechat-customer-extension-channel",
  "name": "WeChat Customer Extension Channel",
  "version": "0.1.0-recovered",
  "type": "channel",
  "description": "Native QwenPaw Channel wrapper for the external recovered WeChat Customer Gateway.",
  "author": "qwenpaw-platform",
  "entry": {
    "backend": "plugin.py"
  },
  "dependencies": [],
  "qwenpaw_version": {
    "min": "2.1.0",
    "max": "2.2.0"
  },
  "meta": {
    "extension": {
      "name": "wechat-customer",
      "type": "plugin",
      "manifest": "plugins/wechat-customer/manifest.yaml",
      "runtime": "python",
      "declared_entrypoint": "recovered/wecom_kf_gateway_v345.py",
      "adapter_entrypoint": "adapters/wechat_customer/runtime.py",
      "config_mapping": {
        "corp_id": "CORP_ID",
        "app_secret": "APP_SECRET",
        "callback_token": "TOKEN",
        "encoding_aes_key": "AESKEY",
        "open_kfid": "OPEN_KFID"
      }
    },
    "permissions": [
      "extension.registry.read",
      "extension.runtime.gateway",
      "channel.wechat-customer.transport"
    ],
    "config": {
      "fields": [
        {
          "name": "corp_id",
          "type": "text",
          "required": true,
          "secret": false
        },
        {
          "name": "app_secret",
          "type": "password",
          "required": true,
          "secret": true
        },
        {
          "name": "callback_token",
          "type": "password",
          "required": true,
          "secret": true
        },
        {
          "name": "encoding_aes_key",
          "type": "password",
          "required": true,
          "secret": true
        },
        {
          "name": "open_kfid",
          "type": "text",
          "required": true,
          "secret": false
        },
        {
          "name": "gateway_url",
          "type": "text",
          "required": true,
          "secret": false,
          "default": "http://127.0.0.1:8798"
        }
      ],
      "values": {}
    },
    "required_secrets": [
      "app_secret",
      "callback_token",
      "encoding_aes_key"
    ]
  }
}
