# Original cloud export (kept locally; contains credentials and runtime data)
qwenpaw-platform-export.zip
channel-runtime-recovery-export.zip
*.tar.gz

# Local credentials and user-specific workspace state
configs/credentials.yaml
configs/credentials.*
configs/PROFILE.md
configs/MEMORY.md
configs/chats.json
configs/jobs.json

# Secret files, private keys, and local credential stores
secrets/
**/.secrets/
**/credentials.local.*
**/*secret*.local.*
*.token
*.secret
*.pem
*.key
*.p12
*.pfx
*.jks
*.kdbx
.netrc
.npmrc
.pypirc

# AgentScope/QwenPaw runtime data
checkpoints/
mem_agent/
mem_metadata/
mem_session/
memory/*
!memory/.gitkeep
sessions/*
!sessions/.gitkeep

# Local databases, generated media, and logs
*.db
*.db-shm
*.db-wal
*.log
media/
tmp/

# Locally generated Extension release artifacts
dist/extensions/

# Local offline Extension deployment simulation
workspace/extensions/

