{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwenpaw.local/schemas/pdf-editor/request.v1.json",
  "title": "PDF Editor SkillRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "skill_id", "files", "parameters", "context"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "skill_id": {"const": "pdf-editor"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true,
      "required": ["plan"],
      "properties": {
        "command": {"const": "apply", "default": "apply"},
        "input_artifact_id": {"type": "string", "minLength": 1},
        "output_name": {"type": "string", "pattern": "^[^/\\\\]+\\.pdf$"},
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations"],
          "properties": {
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "enum": [
                      "replace_text",
                      "delete_text",
                      "delete_pages",
                      "insert_pages",
                      "reorder_pages",
                      "rotate_pages",
                      "add_text",
                      "watermark",
                      "page_numbers",
                      "add_image",
                      "replace_image"
                    ]
                  },
                  "image_artifact_id": {"type": "string", "minLength": 1},
                  "source_artifact_id": {"type": "string", "minLength": 1}
                },
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "context": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "name", "mime_type", "size_bytes", "uri"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["file", "image"]},
        "name": {"type": "string", "minLength": 1},
        "mime_type": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "uri": {"type": "string", "pattern": "^artifact://"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
